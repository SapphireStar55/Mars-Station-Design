else
    % Fallback: create Mars manually
    [X_mars, Y_mars, Z_mars] = sphere(120);
    X_mars = X_mars * R_mars;
    Y_mars = Y_mars * R_mars;
    Z_mars = Z_mars * R_mars;
    
    n_res = 121;
    phi = linspace(0, pi, n_res);
    theta_tex = linspace(0, 2*pi, n_res);
    [PHI, THETA] = meshgrid(phi, theta_tex);
    
    large_scale = 0.3*sin(2*PHI).*cos(3*THETA) + 0.2*sin(3*PHI+1).*cos(2*THETA-0.5);
    medium_scale = 0.15*sin(7*PHI).*cos(8*THETA) + 0.1*sin(5*PHI-0.8).*cos(6*THETA+1.2);
    fine_scale = 0.05*randn(size(PHI));
    terrain = large_scale + medium_scale + fine_scale;
    
    mars_red = 0.65 + 0.25*terrain + 0.05*abs(sin(4*PHI));
    mars_green = 0.22 + 0.12*terrain + 0.03*abs(sin(3*THETA));
    mars_blue = 0.08 + 0.06*terrain + 0.01*abs(cos(2*PHI));
    
    ice_cap = exp(-10*(PHI-0).^2) + exp(-10*(PHI-pi).^2);
    mars_red = mars_red + 0.3*ice_cap;
    mars_green = mars_green + 0.3*ice_cap;
    mars_blue = mars_blue + 0.25*ice_cap;
    
    mars_texture = zeros(n_res, n_res, 3);
    mars_texture(:,:,1) = mars_red';
    mars_texture(:,:,2) = mars_green';
    mars_texture(:,:,3) = mars_blue';
    mars_texture = max(0, min(1, mars_texture));
    
    hold on;
    surf(X_mars, Y_mars, Z_mars, 'CData', mars_texture, ...
        'FaceColor', 'texturemap', 'EdgeColor', 'none', 'FaceAlpha', 1.0);
end

