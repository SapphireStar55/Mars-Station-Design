animate_orbits = draw_orbits;

for frame = 1:n_frames
    % Update each selected orbit
    for idx = animate_orbits
        % Time for this orbit
        t = (frame/n_frames) * orbits(idx).T * 3;
        angle = 2*pi*t/orbits(idx).T;
        
        % Spacecraft position index
        sc_idx = mod(round(angle/(2*pi) * n_points), n_points) + 1;
        
        % Update spacecraft
        x_sc = orbits(idx).x(sc_idx);
        y_sc = orbits(idx).y(sc_idx);
        z_sc = orbits(idx).z(sc_idx);
        set(spacecraft_markers{idx}, 'XData', x_sc, 'YData', y_sc, 'ZData', z_sc);
        
        % Update trail
        trail_start = max(1, sc_idx - trail_length);
        if sc_idx > trail_start
            trail_indices = trail_start:sc_idx;
        else
            trail_indices = [trail_start:n_points, 1:sc_idx];
        end
        set(trail_lines{idx}, 'XData', orbits(idx).x(trail_indices), ...
            'YData', orbits(idx).y(trail_indices), 'ZData', orbits(idx).z(trail_indices));
    end
    
    % Update moons
    T_phobos = 2*pi*sqrt(r_phobos^3/mu_mars);
    T_deimos = 2*pi*sqrt(r_deimos^3/mu_mars);
    
    t_moon = (frame/n_frames) * T_phobos * 3;
    angle_phobos = 2*pi*t_moon/T_phobos;
    angle_deimos = 2*pi*t_moon/T_deimos;
    
    x_p = r_phobos * cos(angle_phobos);
    y_p = r_phobos * sin(angle_phobos) * cos(inc_phobos);
    z_p = r_phobos * sin(angle_phobos) * sin(inc_phobos);
    set(phobos_sphere, 'XData', X_p*phobos_radius + x_p, ...
        'YData', Y_p*phobos_radius + y_p, 'ZData', Z_p*phobos_radius + z_p);
    
    x_d = r_deimos * cos(angle_deimos);
    y_d = r_deimos * sin(angle_deimos) * cos(inc_deimos);
    z_d = r_deimos * sin(angle_deimos) * sin(inc_deimos);
    set(deimos_sphere, 'XData', X_d*deimos_radius + x_d, ...
        'YData', Y_d*deimos_radius + y_d, 'ZData', Z_d*deimos_radius + z_d);
    
    % Camera rotation (only if enabled)
    if rotate_camera == 1
        az = 40 + 110*sin(frame*0.0035);
        el = 25 + 18*cos(frame*0.0028);
        view(az, el);
    end
    
    drawnow;
    pause(0.01);
end

fprintf('Animation complete!\n');
fprintf('\nRe-enabling interactive controls. You can now rotate the view.\n');
rotate3d on;

fprintf('\n=== END OF MISSION ANALYSIS ===\n');
