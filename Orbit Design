clc; clear; close all;

%% Mars Constants
mu_mars = 4.2828e13;          % Mars gravitational parameter (m^3/s^2)
R_mars  = 3389.5e3;           % Mars mean radius (m)

%% Moon Orbital Parameters (from Mars center)
r_phobos  = 9376e3;           % Phobos orbital radius (m)
r_deimos  = 23463e3;          % Deimos orbital radius (m)

% Actual orbital inclinations relative to Mars equator
inc_phobos = 1.08 * pi/180;   % ~1.08 degrees
inc_deimos = 1.79 * pi/180;   % ~1.79 degrees

fprintf('========================================\n');
fprintf('MARS MISSION ORBIT ARCHITECTURE STUDY\n');
fprintf('========================================\n\n');

%% ORBIT TYPE 1: HIGHLY ELLIPTICAL POLAR ORBIT
% Periapsis near Mars surface, apoapsis beyond Deimos
fprintf('Calculating Orbit Type 1: Highly Elliptical Polar...\n');

% Elliptical orbit parameters
r_periapsis_1 = R_mars + 300e3;      % 300 km altitude at periapsis
r_apoapsis_1 = r_deimos * 1.3;       % 30% beyond Deimos at apoapsis
a_ellip_1 = (r_periapsis_1 + r_apoapsis_1) / 2;  % Semi-major axis
e_ellip_1 = (r_apoapsis_1 - r_periapsis_1) / (r_apoapsis_1 + r_periapsis_1);  % Eccentricity
inc_ellip_1 = 90 * pi/180;            % Polar orbit

% Orbital period
T_ellip_1 = 2*pi*sqrt(a_ellip_1^3/mu_mars);

% Calculate velocities at key points
v_peri_1 = sqrt(mu_mars*(2/r_periapsis_1 - 1/a_ellip_1));
v_apo_1 = sqrt(mu_mars*(2/r_apoapsis_1 - 1/a_ellip_1));

% Transfer ΔV calculations
% From parking orbit to elliptical orbit
r_park = R_mars + 400e3;  % 400 km parking orbit
v_park = sqrt(mu_mars/r_park);
dV_insert_1 = abs(v_peri_1 - v_park);  % Insertion burn

% Access to Phobos
r_at_phobos = a_ellip_1*(1-e_ellip_1^2)/(1+e_ellip_1*cos(acos((a_ellip_1*(1-e_ellip_1^2)-r_phobos)/(e_ellip_1*r_phobos))));
v_at_phobos_ellip = sqrt(mu_mars*(2/r_phobos - 1/a_ellip_1));
v_phobos_circ = sqrt(mu_mars/r_phobos);
dV_phobos_1 = abs(v_phobos_circ - v_at_phobos_ellip) + 2*v_phobos_circ*sin(inc_ellip_1/2);

% Access to Deimos
v_at_deimos_ellip = v_apo_1;  % At apoapsis near Deimos
v_deimos_circ = sqrt(mu_mars/r_deimos);
dV_deimos_1 = abs(v_deimos_circ - v_at_deimos_ellip) + 2*v_deimos_circ*sin(inc_ellip_1/2);

% Total mission ΔV
total_dV_1 = dV_insert_1 + dV_phobos_1 + dV_deimos_1;

% Proximity metrics (minimum distances during orbit)
min_dist_mars_1 = r_periapsis_1 - R_mars;
min_dist_phobos_1 = abs(r_phobos - r_periapsis_1);  % Approximate
min_dist_deimos_1 = abs(r_apoapsis_1 - r_deimos);

%% ORBIT TYPE 2: COPLANAR CIRCULAR ORBIT
fprintf('Calculating Orbit Type 2: Coplanar Circular...\n');

% Optimal radius between Phobos and Deimos
r_circular_2 = sqrt(r_phobos * r_deimos);  % Geometric mean
inc_circular_2 = (inc_phobos + inc_deimos)/2;  % Average inclination

% Orbital period
T_circular_2 = 2*pi*sqrt(r_circular_2^3/mu_mars);

% Circular velocity
v_circ_2 = sqrt(mu_mars/r_circular_2);

% Transfer from parking orbit
a_trans_to_circ = (r_park + r_circular_2)/2;
v_park_depart = sqrt(mu_mars*(2/r_park - 1/a_trans_to_circ));
v_circ_arrive = sqrt(mu_mars*(2/r_circular_2 - 1/a_trans_to_circ));
dV_insert_2 = abs(v_park_depart - v_park) + abs(v_circ_2 - v_circ_arrive);

% Access to Phobos (transfer down)
a_to_phobos = (r_circular_2 + r_phobos)/2;
v_phobos_depart = sqrt(mu_mars*(2/r_circular_2 - 1/a_to_phobos));
v_phobos_arrive = sqrt(mu_mars*(2/r_phobos - 1/a_to_phobos));
v_phobos_circ = sqrt(mu_mars/r_phobos);
dV_phobos_2 = abs(v_phobos_depart - v_circ_2) + abs(v_phobos_circ - v_phobos_arrive);
% Plane change
dV_phobos_2 = dV_phobos_2 + 2*v_phobos_arrive*sin(abs(inc_circular_2-inc_phobos)/2);

% Access to Deimos (transfer up)
a_to_deimos = (r_circular_2 + r_deimos)/2;
v_deimos_depart = sqrt(mu_mars*(2/r_circular_2 - 1/a_to_deimos));
v_deimos_arrive = sqrt(mu_mars*(2/r_deimos - 1/a_to_deimos));
v_deimos_circ = sqrt(mu_mars/r_deimos);
dV_deimos_2 = abs(v_deimos_depart - v_circ_2) + abs(v_deimos_circ - v_deimos_arrive);
% Plane change
dV_deimos_2 = dV_deimos_2 + 2*v_deimos_arrive*sin(abs(inc_circular_2-inc_deimos)/2);

% Total mission ΔV
total_dV_2 = dV_insert_2 + dV_phobos_2 + dV_deimos_2;

% Proximity metrics
min_dist_mars_2 = r_circular_2 - R_mars;
min_dist_phobos_2 = abs(r_circular_2 - r_phobos);
min_dist_deimos_2 = abs(r_circular_2 - r_deimos);

%% ORBIT TYPE 3: ELLIPTICAL BETWEEN PHOBOS AND DEIMOS
fprintf('Calculating Orbit Type 3: Elliptical Between Moons...\n');

% Periapsis just outside Phobos, apoapsis at Deimos
r_periapsis_3 = r_phobos * 1.15;      % 15% outside Phobos orbit
r_apoapsis_3 = r_deimos;
a_ellip_3 = (r_periapsis_3 + r_apoapsis_3) / 2;
e_ellip_3 = (r_apoapsis_3 - r_periapsis_3) / (r_apoapsis_3 + r_periapsis_3);
inc_ellip_3 = (inc_phobos + inc_deimos)/2;  % Average inclination

% Orbital period
T_ellip_3 = 2*pi*sqrt(a_ellip_3^3/mu_mars);

% Velocities
v_peri_3 = sqrt(mu_mars*(2/r_periapsis_3 - 1/a_ellip_3));
v_apo_3 = sqrt(mu_mars*(2/r_apoapsis_3 - 1/a_ellip_3));

% Transfer from parking orbit
a_trans_to_ellip = (r_park + r_periapsis_3)/2;
v_park_depart_3 = sqrt(mu_mars*(2/r_park - 1/a_trans_to_ellip));
v_peri_arrive = sqrt(mu_mars*(2/r_periapsis_3 - 1/a_trans_to_ellip));
dV_insert_3 = abs(v_park_depart_3 - v_park) + abs(v_peri_3 - v_peri_arrive);

% Access to Phobos (near periapsis)
v_phobos_circ = sqrt(mu_mars/r_phobos);
dV_phobos_3 = abs(v_phobos_circ - v_peri_3);
% Plane change
dV_phobos_3 = dV_phobos_3 + 2*v_peri_3*sin(abs(inc_ellip_3-inc_phobos)/2);

% Access to Deimos (at apoapsis)
v_deimos_circ = sqrt(mu_mars/r_deimos);
dV_deimos_3 = abs(v_deimos_circ - v_apo_3);
% Plane change
dV_deimos_3 = dV_deimos_3 + 2*v_apo_3*sin(abs(inc_ellip_3-inc_deimos)/2);

% Total mission ΔV
total_dV_3 = dV_insert_3 + dV_phobos_3 + dV_deimos_3;

% Proximity metrics
min_dist_mars_3 = r_periapsis_3 - R_mars;
min_dist_phobos_3 = r_periapsis_3 - r_phobos;  % Distance from periapsis to Phobos orbit
min_dist_deimos_3 = 0;  % Passes through Deimos orbit

%% COMPARISON TABLE
fprintf('\n========================================\n');
fprintf('ORBIT COMPARISON RESULTS\n');
fprintf('========================================\n\n');

fprintf('%-35s | %-15s | %-15s | %-15s\n', 'PARAMETER', 'Ellip. Polar', 'Coplanar Circ.', 'Ellip. Between');
fprintf('%.100s\n', repmat('-', 1, 100));

fprintf('%-35s | %12.2f km | %12.2f km | %12.2f km\n', 'Periapsis altitude', ...
    (r_periapsis_1-R_mars)/1000, (r_circular_2-R_mars)/1000, (r_periapsis_3-R_mars)/1000);
fprintf('%-35s | %12.2f km | %12.2f km | %12.2f km\n', 'Apoapsis altitude', ...
    (r_apoapsis_1-R_mars)/1000, (r_circular_2-R_mars)/1000, (r_apoapsis_3-R_mars)/1000);
fprintf('%-35s | %15.3f | %15.3f | %15.3f\n', 'Eccentricity', e_ellip_1, 0.0, e_ellip_3);
fprintf('%-35s | %12.1f deg | %12.1f deg | %12.1f deg\n', 'Inclination', ...
    inc_ellip_1*180/pi, inc_circular_2*180/pi, inc_ellip_3*180/pi);
fprintf('%-35s | %12.2f hrs | %12.2f hrs | %12.2f hrs\n', 'Orbital Period (TOF)', ...
    T_ellip_1/3600, T_circular_2/3600, T_ellip_3/3600);

fprintf('\n%-35s\n', '--- DELTA-V BUDGET ---');
fprintf('%-35s | %12.0f m/s | %12.0f m/s | %12.0f m/s\n', 'Insertion ΔV', ...
    dV_insert_1, dV_insert_2, dV_insert_3);
fprintf('%-35s | %12.0f m/s | %12.0f m/s | %12.0f m/s\n', 'Phobos Access ΔV', ...
    dV_phobos_1, dV_phobos_2, dV_phobos_3);
fprintf('%-35s | %12.0f m/s | %12.0f m/s | %12.0f m/s\n', 'Deimos Access ΔV', ...
    dV_deimos_1, dV_deimos_2, dV_deimos_3);
fprintf('%-35s | %12.0f m/s | %12.0f m/s | %12.0f m/s\n', 'TOTAL MISSION ΔV', ...
    total_dV_1, total_dV_2, total_dV_3);

fprintf('\n%-35s\n', '--- PROXIMITY METRICS ---');
fprintf('%-35s | %12.0f km | %12.0f km | %12.0f km\n', 'Min. Distance to Mars Surface', ...
    min_dist_mars_1/1000, min_dist_mars_2/1000, min_dist_mars_3/1000);
fprintf('%-35s | %12.0f km | %12.0f km | %12.0f km\n', 'Min. Distance to Phobos', ...
    min_dist_phobos_1/1000, min_dist_phobos_2/1000, min_dist_phobos_3/1000);
fprintf('%-35s | %12.0f km | %12.0f km | %12.0f km\n', 'Min. Distance to Deimos', ...
    min_dist_deimos_1/1000, min_dist_deimos_2/1000, min_dist_deimos_3/1000);

fprintf('\n========================================\n');

%% Store orbit data for visualization
orbits = struct();

% Orbit 1: Highly Elliptical Polar
orbits(1).name = 'Highly Elliptical Polar';
orbits(1).type = 'elliptical';
orbits(1).a = a_ellip_1;
orbits(1).e = e_ellip_1;
orbits(1).inc = inc_ellip_1;
orbits(1).RAAN = 45 * pi/180;
orbits(1).omega = 0;  % Argument of periapsis
orbits(1).T = T_ellip_1;
orbits(1).color = [0.4 0.8 1];

% Orbit 2: Coplanar Circular
orbits(2).name = 'Coplanar Circular';
orbits(2).type = 'circular';
orbits(2).r = r_circular_2;
orbits(2).inc = inc_circular_2;
orbits(2).RAAN = 0;
orbits(2).T = T_circular_2;
orbits(2).color = [1 0.8 0.2];

% Orbit 3: Elliptical Between Moons
orbits(3).name = 'Elliptical Between Moons (Outside Phobos)';
orbits(3).type = 'elliptical';
orbits(3).a = a_ellip_3;
orbits(3).e = e_ellip_3;
orbits(3).inc = inc_ellip_3;
orbits(3).RAAN = 0;
orbits(3).omega = 0;
orbits(3).T = T_ellip_3;
orbits(3).color = [0.8 0.4 1];

%% Generate orbit paths
n_points = 500;

for i = 1:3
    if strcmp(orbits(i).type, 'elliptical')
        % True anomaly
        nu = linspace(0, 2*pi, n_points);
        
        % Orbital radius
        r_orbit = orbits(i).a * (1 - orbits(i).e^2) ./ (1 + orbits(i).e * cos(nu));
        
        % Position in orbital plane
        x_plane = r_orbit .* cos(nu);
        y_plane = r_orbit .* sin(nu);
        z_plane = zeros(size(nu));
        
        % Rotation matrices
        R_omega = [cos(orbits(i).omega), -sin(orbits(i).omega), 0;
                   sin(orbits(i).omega), cos(orbits(i).omega), 0;
                   0, 0, 1];
        
        R_inc = [1, 0, 0;
                 0, cos(orbits(i).inc), -sin(orbits(i).inc);
                 0, sin(orbits(i).inc), cos(orbits(i).inc)];
        
        R_RAAN = [cos(orbits(i).RAAN), -sin(orbits(i).RAAN), 0;
                  sin(orbits(i).RAAN), cos(orbits(i).RAAN), 0;
                  0, 0, 1];
        
        R_total = R_RAAN * R_inc * R_omega;
        
        % Apply rotation
        orbits(i).x = zeros(size(nu));
        orbits(i).y = zeros(size(nu));
        orbits(i).z = zeros(size(nu));
        
        for k = 1:length(nu)
            pos_rotated = R_total * [x_plane(k); y_plane(k); z_plane(k)];
            orbits(i).x(k) = pos_rotated(1);
            orbits(i).y(k) = pos_rotated(2);
            orbits(i).z(k) = pos_rotated(3);
        end
        
    else  % Circular
        theta = linspace(0, 2*pi, n_points);
        
        % Position in orbital plane
        x_plane = orbits(i).r * cos(theta);
        y_plane = orbits(i).r * sin(theta);
        z_plane = zeros(size(theta));
        
        % Rotation matrices
        R_inc = [1, 0, 0;
                 0, cos(orbits(i).inc), -sin(orbits(i).inc);
                 0, sin(orbits(i).inc), cos(orbits(i).inc)];
        
        R_RAAN = [cos(orbits(i).RAAN), -sin(orbits(i).RAAN), 0;
                  sin(orbits(i).RAAN), cos(orbits(i).RAAN), 0;
                  0, 0, 1];
        
        R_total = R_RAAN * R_inc;
        
        % Apply rotation
        orbits(i).x = zeros(size(theta));
        orbits(i).y = zeros(size(theta));
        orbits(i).z = zeros(size(theta));
        
        for k = 1:length(theta)
            pos_rotated = R_total * [x_plane(k); y_plane(k); z_plane(k)];
            orbits(i).x(k) = pos_rotated(1);
            orbits(i).y(k) = pos_rotated(2);
            orbits(i).z(k) = pos_rotated(3);
        end
    end
end

